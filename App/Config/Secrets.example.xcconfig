// Copy this file to App/Config/Secrets.xcconfig (that copy is gitignored).
// Keep the /$()/ sequence so the URL's double slash is not treated as a comment.
// Paste the Project URL and the anon public key from Project Settings → API.
// Never paste the service_role key, and never commit Secrets.xcconfig.
SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY
